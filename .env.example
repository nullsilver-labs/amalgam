# Generate a strong instance password: openssl rand -hex 24
APP_PASSWORD=
# Exact browser origin: the scheme, host and port you will actually type.
# It is only an address; whether that address is acceptable is the next two
# settings' business. Local default:
ORIGIN=http://localhost:8790
AMALGAM_PORT=8790
# For direct LAN access, set this to the server's LAN IP and update ORIGIN above.
# Use a specific interface rather than exposing the app on every network.
AMALGAM_BIND_ADDRESS=127.0.0.1
# Serving an http:// ORIGIN that is not loopback needs this said out loud.
# Without it the app answers 503 and names this variable. With it, startup warns
# once: passwords and conversations travel unencrypted unless the tunnel
# encrypts them, and the browser will not treat the page as a secure context
# (no clipboard API, no microphone) however private the network is.
# AMALGAM_PRIVATE_HTTP=true
# Comma-separated IPs or CIDRs, v4 or v6. From these socket peers only,
# X-Forwarded-Host and X-Forwarded-Proto are believed; from anyone else they are
# ignored. Set it to your reverse proxy's address when the proxy does not
# preserve the browser's Host header. Empty means trust nobody's headers.
# AMALGAM_TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16
# Safe bind for native npm start. Docker overrides HOST/PORT inside its container.
HOST=127.0.0.1
PORT=8790
# Compose's internal DB password. Change for each deployment. No host-published DB.
POSTGRES_PASSWORD=amalgam-local-development
# Native npm development only (Docker injects its own internal URL):
# DATABASE_URL=postgresql://amalgam:your-password@localhost:5432/amalgam

# Configure only the providers you want. OpenAI-compatible slots need an API
# base URL and key (optional for keyless services). OPENAI_BASE_URL has a default.
# Empty/omitted *_MODELS enables server-side GET <base>/models on authenticated
# workspace load or chat; no generation is used. Unconfigured slots are not probed.
# Nonempty comma-separated *_MODELS is an authoritative offline override.
# Discovery: 5s timeout, 4 MiB body, 2000 IDs; redirects refused. Cached 5 minutes,
# failures 30 seconds. Settings > Models reports errors and manual fallback.
# Discovered context windows are unknown. In an explicit list, append
# ":<tokens>" or ":<n>k" to declare a KNOWN window, e.g. llama3.1:8b:8k.
# Unknown windows use the instance budget, which the provider may reject.
OPENAI_API_KEY=
OPENAI_MODELS=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Messages API does not auto-discover: supply model IDs manually.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama example. Its server must accept connections from Docker.
# COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
# Shown as the provider's name in the model picker.
COMPATIBLE_NAME=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=

# Any number more. Name them here; each then reads its own prefix, upper-cased.
# Keys are optional for these, as for COMPATIBLE. Use the API base, including
# /v1 (or the vendor's equivalent), not /models or /chat/completions.
# Add <PREFIX>_KIND=anthropic for Anthropic's Messages API (manual models needed);
# openai is assumed. Leave *_MODELS empty/omitted to discover OpenAI-style IDs.
# PROVIDERS=openrouter,ollama
# OPENROUTER_NAME=OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# Optional manual override (disables discovery; declare only known windows):
# OPENROUTER_MODELS=anthropic/claude-sonnet-4:200k
# OLLAMA_NAME=Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODELS=llama3.1:8b:8k

# Optional overlays. The networks are created once by the operator and are
# never made by these files:
#   docker network create nullsilver-apps        # corpus <-> amalgam
#   docker network create nullsilver-inference   # a shared embedder
APPS_NETWORK=nullsilver-apps
INFERENCE_NETWORK=nullsilver-inference
# compose.corpus.yaml joins only the app to the apps network. Reaching corpus is
# not permission to read it: the connector presents this read-scoped token,
# minted in corpus with `corpus token create "amalgam" --scopes read`, and
# corpus decides what it may see. amalgam reads three routes, and only when you
# ask: a diagnostic probe, a search you typed, and the cards you attached to a
# message. It never writes anything into your library.
CORPUS_BASE_URL=
CORPUS_TOKEN=
# Optional, and only used for links a person clicks in the transcript: the
# address you open corpus at in a browser, such as https://corpus.example.com.
# A service name on a Docker network is not one; leave it empty and the sources
# under a message stay plain text.
CORPUS_PUBLIC_URL=
# compose.inference.yaml joins only the app to the inference network.
EMBEDDING_BASE_URL=
