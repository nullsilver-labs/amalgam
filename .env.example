# Copy to .env (gitignored). Secrets never enter ~/.amalgam, which is a git repo.

# Model provider key(s). One is enough; amalgam uses whatever Pi supports.
ANTHROPIC_API_KEY=

# Timezone. Every "yesterday" and every cron-style behavior depends on it.
TZ=Europe/Rome

# Default timeout (seconds) applied to bash calls when the model omits one.
# Mandatory in run/rpc modes, where nobody can abort a hung command.
AMALGAM_BASH_TIMEOUT=300

# --- Telegram gateway (M3) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs. Unknown senders receive nothing.
AMALGAM_ALLOWLIST=
