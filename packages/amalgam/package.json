{
  "name": "@nullsilver/amalgam",
  "version": "0.1.0",
  "description": "Minimal, primitives-first harness for a persistent personal agent: a directory of plain text, a loop, four tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "amalgam": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "prompts",
    "defaults",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
